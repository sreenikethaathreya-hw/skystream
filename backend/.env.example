# Copy to backend/.env. Every value below is optional; the defaults run the demo with SQLite, offline AI.
# In GCP, DATABASE_URL and JEV_API_KEY come from Secret Manager instead (see deploy/).

# --- Mode -------------------------------------------------------------------------------------------
# demo: anonymized seed, role switcher, simulated clock. real: admin uploads, Firebase sign-in.
DATA_MODE=demo
NODE_ENV=development
# Planning year in real mode (defaults to the calendar year).
# CURRENT_YEAR=2026

# --- Database ---------------------------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./skystream.db
# Local Postgres from docker-compose.yml:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skystream
# Seed the demo data on startup when the database is empty (never seeds in real mode).
AUTO_SEED=true
CORS_ORIGIN=http://localhost:5173

# --- Jev (TypeSafe decision model) ------------------------------------------------------------------
# auto: live when JEV_API_KEY is set, otherwise replay recorded fixtures. record: call live and save fixtures.
AI_MODE=auto
JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai/v1
# JEV_MODEL=jev-1.13.0
# JEV_TIMEOUT_SECONDS=5.0
# JEV_CONFIDENCE_THRESHOLD=0.8
# JEV_SCORE_CONFIDENCE_THRESHOLD=0.4
# Real mode only: allow real text to reach Jev's hosted API (also switchable in Admin: settings).
EXTERNAL_AI_ALLOWED=false

# --- Gemini on Vertex AI (prose, low-confidence fallback, and the "Ask the data" agent) ---------------
# Needs Application Default Credentials: gcloud auth application-default login
GEMINI_ENABLED=false
GCP_PROJECT=
GCP_LOCATION=global
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_TIMEOUT_SECONDS=5.0
# Only needed for ADK's own CLI (adk web / adk eval); the app passes GCP_PROJECT and GCP_LOCATION itself.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_ENTERPRISE=True

# --- Ask the data (Google ADK chat) -----------------------------------------------------------------
CHAT_ENABLED=true
# CHAT_MAX_LLM_CALLS=8
# CHAT_HISTORY_EVENTS=40
# CHAT_TEMPERATURE=0.1
# CHAT_APP_NAME=skystream-data-chat

# --- Firebase sign-in (real mode) -------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Defaults to <FIREBASE_PROJECT_ID>.firebaseapp.com
# FIREBASE_AUTH_DOMAIN=
# Comma-separated emails that become admins on first sign-in.
BOOTSTRAP_ADMIN_EMAILS=

# --- Business defaults (admins can override in Admin: settings) -------------------------------------
# GROWER_HA_CAP=500
# CURRENCY=EUR
